# Telegram Bot
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username
ADMIN_IDS=123456789,987654321
BOT_PROXY_URL=

# Database
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Payment Methods
PAYMENT_RECIPIENT_NAME=
YOOMONEY_WALLET=
YOOMONEY_SECRET=
OZON_REQUISITE=
CRYPTO_PAY_TOKEN=

# 3x-ui Panel Configuration
XUI_HOST=https://your-3xui-panel-host:2083
XUI_USERNAME=admin
XUI_PASSWORD=password
XUI_TOKEN=
XUI_INBOUND_ID=1
XUI_TOTP_SECRET=

# Subscription URLs & Sub Server
SUB_DOMAIN=your-sub-domain.com
SUB_PORT=2096
SUB_PATH=/sub/
SUB_TLS=true
SUB_FETCH_VERIFY_TLS=false

PUBLIC_SUB_BASE_URL=https://your-domain.com/sub
SUB_SERVER_HOST=0.0.0.0
SUB_SERVER_PORT=8081
BRAND_NAME=VeiloraVPN
SUB_UPDATE_INTERVAL_HOURS=12

# Mini App
MINIAPP_URL=https://your-domain.com
JWT_SECRET=your_secret_key

# Trial
TRIAL_ENABLED=true
TRIAL_DURATION_DAYS=3
